  <dashboards>
    <dashboard name='Who Rules the Skies'>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#EEF3F7' />
        </style-rule>
      </style>
      <size maxheight='1600' maxwidth='1900' minheight='1600' minwidth='1900' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Competition' datatype='string' name='[Competition]' param-domain-type='list' role='measure' type='nominal' value='&quot;Men&quot;'>
          <calculation class='tableau' formula='&quot;Men&quot;' />
          <members>
            <member value='&quot;Men&quot;' />
            <member value='&quot;Women&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='11' is-scaled='1' param='C:/Projects/tableau-portfolio/ski-jumping/tableau/img/background.png' type-v2='bitmap' w='100000' x='0' y='0'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
            </zone-style>
          </zone>
          <zone h='1500' id='12' type-v2='text' w='30526' x='2526' y='2875'>
            <formatted-text>
              <run fontcolor='#1f5fad' fontname='Tableau Medium' fontsize='11'>FIS Ski Jumping World Cup – men since 2001, women since 2012</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='4500' id='13' type-v2='text' w='31053' x='2526' y='4500'>
            <formatted-text>
              <run fontcolor='#0b1f33' fontname='Tableau Bold' fontsize='38'>Who rules the skies?</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='6875' id='14' type-v2='text' w='29474' x='2526' y='9375'>
            <formatted-text>
              <run fontcolor='#4f6275' fontname='Tableau Book' fontsize='13'>Every winter a few dozen athletes launch themselves off a ramp at around 90 km/h and try to stay in the air for longer than a football pitch. A handful of nations have made a habit of winning. None of them stays on top for long.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='4875' id='15' mode='list' param='[Parameters].[Competition]' type-v2='paramctrl' w='11158' x='2526' y='16750'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='background-color' value='#eef3f7' />
            </zone-style>
          </zone>
          <zone h='3875' id='16' type-v2='text' w='17895' x='14211' y='17625'>
            <formatted-text>
              <run fontcolor='#4f6275' fontname='Tableau Book' fontsize='10'>Pick a competition – the charts and the writing both switch over. Hover the charts for the jumpers behind them.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='6375' id='17' name='BAN top_nation' show-title='false' w='12316' x='34211' y='4875'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
