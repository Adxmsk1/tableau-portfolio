    <worksheet name='Venues'>
      <table>
        <view>
          <datasources>
            <datasource caption='Venues' name='federated.venues' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Runners' datatype='string' name='[Runners]' param-domain-type='list' role='measure' type='nominal' value='&quot;Men&quot;'>
              <calculation class='tableau' formula='&quot;Men&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.venues'>
            <column caption='Sex match' datatype='boolean' name='[Sex match]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[sex] = [Parameters].[Runners]' />
            </column>
            <column caption='Yr' datatype='string' name='[Yr]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;&apos;&quot; + RIGHT(STR([season]), 2)' />
            </column>
            <column caption='Elite Performances' datatype='real' default-format='n#,##0;-#,##0' name='[elite_performances]' role='measure' type='quantitative' />
            <column caption='Fastest Runner' datatype='string' name='[fastest_runner]' role='dimension' type='nominal' />
            <column caption='Fastest Time' datatype='string' name='[fastest_time]' role='dimension' type='nominal' />
            <column-instance column='[fastest_runner]' derivation='Min' name='[min:fastest_runner:nk]' pivot='key' type='nominal' />
            <column-instance column='[fastest_time]' derivation='Min' name='[min:fastest_time:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sex match]' derivation='None' name='[none:Sex match:nk]' pivot='key' type='nominal' />
            <column-instance column='[Yr]' derivation='None' name='[none:Yr:ok]' pivot='key' type='nominal' />
            <column-instance column='[season]' derivation='None' name='[none:season:ok]' pivot='key' type='ordinal' />
            <column-instance column='[venue]' derivation='None' name='[none:venue:nk]' pivot='key' type='nominal' />
            <column caption='Season' datatype='integer' name='[season]' role='dimension' type='ordinal' />
            <column caption='Sex' datatype='string' name='[sex]' role='dimension' type='nominal' />
            <column caption='Share Of Season' datatype='real' default-format='p0%' name='[share_of_season]' role='measure' type='quantitative' />
            <column-instance column='[elite_performances]' derivation='Sum' name='[sum:elite_performances:qk]' pivot='key' type='quantitative' />
            <column-instance column='[share_of_season]' derivation='Sum' name='[sum:share_of_season:qk]' pivot='key' type='quantitative' />
            <column caption='Venue' datatype='string' name='[venue]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.venues].[none:Sex match:nk]'>
            <groupfilter function='member' level='[none:Sex match:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <computed-sort column='[federated.venues].[none:venue:nk]' direction='DESC' using='[federated.venues].[sum:elite_performances:qk]' />
          <slices>
            <column>[federated.venues].[none:Sex match:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value='#6A645C' />
            <format attr='font-size' value='9' />
            <format attr='title' class='0' field='[federated.venues].[none:Yr:ok]' scope='cols' value='' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#6A645C' />
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='border-color' value='#FFFFFF' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#FFFFFF' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='color' value='#1F2328' />
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
          <style-rule element='dropline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <size column='[federated.venues].[sum:elite_performances:qk]' />
              <lod column='[federated.venues].[none:season:ok]' />
              <tooltip column='[federated.venues].[min:fastest_runner:nk]' />
              <tooltip column='[federated.venues].[min:fastest_time:nk]' />
              <tooltip column='[federated.venues].[sum:share_of_season:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#c4462b' fontname='Tableau Bold' fontsize='12'><![CDATA[<[federated.venues].[none:venue:nk]>]]></run>
                <run> · </run>
                <run fontcolor='#6a645c'><![CDATA[<[federated.venues].[none:season:ok]>]]></run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Bold' fontsize='12'><![CDATA[<[federated.venues].[sum:elite_performances:qk]>]]></run>
                <run> elite marathons - </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.venues].[sum:share_of_season:qk]>]]></run>
                <run> of the year&apos;s total</run>
                <run>Æ&#10;</run>
                <run>Fastest here: </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.venues].[min:fastest_runner:nk]>]]></run>
                <run>, </run>
                <run><![CDATA[<[federated.venues].[min:fastest_time:nk]>]]></run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-color' value='#C4462B' />
                <format attr='size' value='2.5' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.venues].[none:venue:nk]</rows>
        <cols>[federated.venues].[none:Yr:ok]</cols>
      </table>
      <simple-id uuid='{4A26FDE9-A505-4B7A-A192-DF3D4F8E8A3D}' />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='The Fastest Decade'>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#F5F1EA' />
        </style-rule>
      </style>
      <size maxheight='3856' maxwidth='1400' minheight='3856' minwidth='1400' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Runners' datatype='string' name='[Runners]' param-domain-type='list' role='measure' type='nominal' value='&quot;Men&quot;'>
          <calculation class='tableau' formula='&quot;Men&quot;' />
          <members>
            <member value='&quot;Men&quot;' />
            <member value='&quot;Women&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='1670' id='11' is-scaled='1' param='C:/Projects/tableau-portfolio/running/tableau/img/track.png' type-v2='bitmap' w='100000' x='0' y='0'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
            </zone-style>
          </zone>
          <zone h='626' id='12' type-v2='text' w='54286' x='9286' y='2140'>
            <formatted-text>
              <run fontcolor='#c4462b' fontname='Tableau Medium' fontsize='12' italic='true'>Road running, 2001 to 2025</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='3444' id='13' type-v2='text' w='52857' x='9286' y='2818'>
            <formatted-text>
              <run fontcolor='#1f2328' fontname='Tableau Bold' fontsize='32'>The fastest decade
in marathon history</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='1879' id='14' type-v2='text' w='50000' x='9286' y='6262'>
            <formatted-text>
              <run fontcolor='#6a645c' fontname='Tableau Book' fontsize='13'>In 2017 Nike put a carbon plate and a thick layer of springy foam into a racing shoe. Within a few years, elite marathon running looked like a different sport. The shoes got the headlines, but they aren&apos;t the only reason times fell.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='1983' id='15' mode='list' param='[Parameters].[Runners]' type-v2='paramctrl' w='17143' x='9286' y='8246'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='background-color' value='#f5f1ea' />
            </zone-style>
          </zone>
          <zone h='1148' id='16' type-v2='text' w='33571' x='27143' y='8716'>
            <formatted-text>
              <run fontcolor='#6a645c' fontname='Tableau Book' fontsize='10' italic='true'>Switch between men and women and everything below changes with it.
Hover over the charts for names and times.</run>
