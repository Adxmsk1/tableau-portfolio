    <worksheet name='Nations'>
      <table>
        <view>
          <datasources>
            <datasource caption='Grandmasters by nation' name='federated.feds' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Nation' datatype='string' name='[Nation]' param-domain-type='list' role='measure' type='nominal' value='&quot;All nations&quot;'>
              <calculation class='tableau' formula='&quot;All nations&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.feds'>
            <column caption='Line' datatype='string' name='[Line]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Nation] = &quot;All nations&quot; OR [nation] = [Parameters].[Nation] THEN [nation] ELSE &quot;Other&quot; END' />
            </column>
            <column caption='Gms' datatype='integer' default-format='n#,##0;-#,##0' name='[gms]' role='measure' type='quantitative' />
            <column caption='Median Age' datatype='real' default-format='n#,##0;-#,##0' name='[median_age]' role='measure' type='quantitative' />
            <column caption='Nation' datatype='string' name='[nation]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Line]' derivation='None' name='[none:Line:nk]' pivot='key' type='nominal' />
            <column-instance column='[nation]' derivation='None' name='[none:nation:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[gms]' derivation='Sum' name='[sum:gms:qk]' pivot='key' type='quantitative' />
            <column-instance column='[median_age]' derivation='Sum' name='[sum:median_age:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value='#6B6157' />
            <format attr='font-size' value='9' />
            <format attr='title' class='0' field='[federated.feds].[sum:gms:qk]' scope='rows' value='' />
            <format attr='title' class='0' field='[federated.feds].[none:year:ok]' scope='cols' value='' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#6B6157' />
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.feds].[none:Line:nk]' type='palette'>
              <map to='#2d5da8'>
                <bucket>&quot;USA&quot;</bucket>
              </map>
              <map to='#3b8ea5'>
                <bucket>&quot;Ukraine&quot;</bucket>
              </map>
              <map to='#4a4a4a'>
                <bucket>&quot;Germany&quot;</bucket>
              </map>
              <map to='#b23a3a'>
                <bucket>&quot;Russia&quot;</bucket>
              </map>
              <map to='#c9a227'>
                <bucket>&quot;China&quot;</bucket>
              </map>
              <map to='#d8ccb8'>
                <bucket>&quot;Other&quot;</bucket>
              </map>
              <map to='#e07a1f'>
                <bucket>&quot;India&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
          <style-rule element='pane'>
            <format attr='border-color' value='#FFFDF8' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#FFFDF8' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='color' value='#231F1A' />
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
          <style-rule element='dropline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='on' />
            <format attr='stroke-color' value='#EFE8DC' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.feds].[none:Line:nk]' />
              <lod column='[federated.feds].[none:nation:nk]' />
              <tooltip column='[federated.feds].[sum:median_age:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#7a4a2a' fontname='Georgia' fontsize='12'><![CDATA[<[federated.feds].[none:nation:nk]>]]></run>
                <run> · </run>
                <run fontcolor='#6b6157'><![CDATA[<[federated.feds].[none:year:ok]>]]></run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Bold' fontsize='12'>&lt;[federated.feds].[sum:gms:qk]&gt;</run>
                <run> grandmasters on the list</run>
                <run>Æ&#10;</run>
                <run>Half of them were </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.feds].[sum:median_age:qk]>]]></run>
                <run> or older</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.feds].[sum:gms:qk]</rows>
        <cols>[federated.feds].[none:year:ok]</cols>
      </table>
