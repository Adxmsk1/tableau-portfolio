    <worksheet name='Top 100 ages'>
      <table>
        <view>
          <datasources>
            <datasource caption='World top 100 by age' name='federated.top100' />
          </datasources>
          <datasource-dependencies datasource='federated.top100'>
            <column-instance column='[avg_age_top100]' derivation='Avg' name='[avg:avg_age_top100:qk]' pivot='key' type='quantitative' />
            <column caption='Avg Age Top100' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[avg_age_top100]' role='measure' type='quantitative' />
            <column caption='Band' datatype='string' name='[band]' role='dimension' type='nominal' />
            <column caption='Band Order' datatype='integer' name='[band_order]' role='measure' type='quantitative' />
            <column caption='Leading Players' datatype='string' name='[leading_players]' role='dimension' type='nominal' />
            <column-instance column='[leading_players]' derivation='Min' name='[min:leading_players:nk]' pivot='key' type='nominal' />
            <column-instance column='[band]' derivation='None' name='[none:band:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
            <column caption='Players' datatype='integer' default-format='n#,##0;-#,##0' name='[players]' role='measure' type='quantitative' />
            <column-instance column='[band_order]' derivation='Sum' name='[sum:band_order:qk]' pivot='key' type='quantitative' />
            <column-instance column='[players]' derivation='Sum' name='[sum:players:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <computed-sort column='[federated.top100].[none:band:nk]' direction='ASC' using='[federated.top100].[sum:band_order:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value='#6B6157' />
            <format attr='font-size' value='9' />
            <format attr='title' class='0' field='[federated.top100].[none:year:ok]' scope='cols' value='' />
            <format attr='title' class='0' field='[federated.top100].[none:band:nk]' scope='rows' value='' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#6B6157' />
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.top100].[sum:players:qk]' palette='brown_10_0' type='interpolated' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='border-color' value='#FFFDF8' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#FFFDF8' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='color' value='#231F1A' />
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
          <style-rule element='dropline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.top100].[sum:players:qk]' />
              <tooltip column='[federated.top100].[min:leading_players:nk]' />
              <tooltip column='[federated.top100].[avg:avg_age_top100:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#7a4a2a' fontname='Georgia' fontsize='12'><![CDATA[<[federated.top100].[none:year:ok]>]]></run>
                <run> · </run>
                <run fontcolor='#6b6157'><![CDATA[<[federated.top100].[none:band:nk]>]]></run>
                <run>Æ&#10;</run>
                <run fontname='Tableau Bold' fontsize='12'><![CDATA[<[federated.top100].[sum:players:qk]>]]></run>
                <run> of the world top 100</run>
                <run>Æ&#10;</run>
                <run>Highest rated: </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.top100].[min:leading_players:nk]>]]></run>
                <run>Æ&#10;</run>
                <run>Top-100 average age that year: </run>
                <run><![CDATA[<[federated.top100].[avg:avg_age_top100:qk]>]]></run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='5' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.top100].[none:year:ok]</rows>
        <cols>[federated.top100].[none:band:nk]</cols>
      </table>
      <simple-id uuid='{7223D171-F1A2-47AB-ADF0-40B793E64DCC}' />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Is Chess Getting Younger'>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#FFFDF8' />
        </style-rule>
      </style>
      <size maxheight='1880' maxwidth='1736' minheight='1880' minwidth='1736' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Nation' datatype='string' name='[Nation]' param-domain-type='list' role='measure' type='nominal' value='&quot;All nations&quot;'>
          <calculation class='tableau' formula='&quot;All nations&quot;' />
          <members>
            <member value='&quot;All nations&quot;' />
            <member value='&quot;India&quot;' />
            <member value='&quot;USA&quot;' />
            <member value='&quot;Russia&quot;' />
            <member value='&quot;China&quot;' />
            <member value='&quot;Ukraine&quot;' />
            <member value='&quot;Germany&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='11' is-scaled='1' param='C:/Projects/tableau-portfolio/chess/tableau/img/board.png' type-v2='bitmap' w='100000' x='0' y='0'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
            </zone-style>
          </zone>
          <zone h='1170' id='12' type-v2='text' w='28802' x='5703' y='3777'>
            <formatted-text>
              <run fontcolor='#7a4a2a' fontname='Georgia' fontsize='12' italic='true'>Twenty-five years of FIDE rating lists</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='3191' id='13' type-v2='text' w='43203' x='5703' y='5053'>
            <formatted-text>
              <run bold='true' fontcolor='#231f1a' fontname='Georgia' fontsize='33'>Is chess getting younger?</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='5851' id='14' type-v2='text' w='42742' x='5703' y='8670'>
            <formatted-text>
              <run fontcolor='#6b6157' fontname='Tableau Book' fontsize='13'>In December 2024 an 18-year-old from Chennai became the youngest undisputed world champion in history. Was Gukesh a one-off, or part of something bigger? Twenty-five years of FIDE rating lists – every rated player&apos;s age, title and rating – are a good place to look.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='2340' id='15' type-v2='text' w='42742' x='5703' y='13564'>
            <formatted-text>
              <run fontcolor='#231f1a' fontname='Tableau Book' fontsize='11'>Five moves, pawn to king: new grandmasters, record-breakers, the world top 100, the nations and the 2700 club. Hover over a dot, bar or line to see who it is.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='padding' value='0' />
            </zone-style>
          </zone>
          <zone h='3404' id='16' mode='compact' param='[Parameters].[Nation]' type-v2='paramctrl' w='13249' x='5703' y='18032'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='background-color' value='#fffdf8' />
            </zone-style>
          </zone>
          <zone h='1064' id='17' type-v2='text' w='23041' x='5703' y='16968'>
            <formatted-text>
              <run fontcolor='#7a4a2a' fontname='Georgia' fontsize='11' italic='true'>Pick a nation to follow its players through the story</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
