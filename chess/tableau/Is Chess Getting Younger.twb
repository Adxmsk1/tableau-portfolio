            <column caption='Player' datatype='string' name='[player]' role='dimension' type='nominal' />
            <column-instance column='[age]' derivation='Sum' name='[sum:age:qk]' pivot='key' type='quantitative' />
            <column-instance column='[held_for]' derivation='Sum' name='[sum:held_for:qk]' pivot='key' type='quantitative' />
            <column-instance column='[x]' derivation='Sum' name='[sum:x:qk]' pivot='key' type='quantitative' />
            <column-instance column='[year]' derivation='Sum' name='[sum:year:qk]' pivot='key' type='quantitative' />
            <column caption='X' datatype='real' default-format='n0;-0' name='[x]' role='measure' type='quantitative' />
            <column caption='Year' datatype='integer' default-format='n0;-0' name='[year]' role='dimension' type='ordinal' />
