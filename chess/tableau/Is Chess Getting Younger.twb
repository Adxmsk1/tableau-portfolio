          <datasources>
            <datasource caption='New grandmasters' name='federated.gms' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Nation' datatype='string' name='[Nation]' param-domain-type='list' role='measure' type='nominal' value='&quot;All nations&quot;'>
              <calculation class='tableau' formula='&quot;All nations&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.gms'>
            <column caption='Dot size' datatype='real' name='[Dot size]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [kind] = &quot;Median&quot; THEN 5 ELSEIF [nation] = [Parameters].[Nation] THEN 2.5 ELSE 1 END' />
            </column>
            <column caption='Dot' datatype='string' name='[Dot]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [kind] = &quot;Median&quot; THEN &quot;Median age&quot; ELSE IF [Parameters].[Nation] = &quot;All nations&quot; THEN (IF [title_age] &lt; 18 THEN &quot;Young&quot; ELSE &quot;Grandmaster&quot; END) ELSEIF [nation] = [Parameters].[Nation] THEN &quot;Selected nation&quot; ELSE &quot;Other nations&quot; END END' />
            </column>
            <column caption='Show' datatype='boolean' name='[Show]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[kind] = &quot;Grandmaster&quot; OR [lens] = [Parameters].[Nation]' />
            </column>
            <column caption='Tip' datatype='string' name='[Tip]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [kind] = &quot;Median&quot; THEN &quot;Typical age of a new grandmaster in &quot; + [era] + &quot;: &quot; + STR(INT([title_age])) ELSE &quot;Became a grandmaster in &quot; + STR(INT([title_year])) + &quot;, aged about &quot; + STR(INT([title_age])) END' />
            </column>
            <column caption='Era' datatype='string' name='[era]' role='dimension' type='nominal' />
            <column caption='Fed' datatype='string' name='[fed]' role='dimension' type='nominal' />
            <column caption='Kind' datatype='string' name='[kind]' role='dimension' type='nominal' />
            <column caption='Lens' datatype='string' name='[lens]' role='dimension' type='nominal' />
            <column-instance column='[Tip]' derivation='Min' name='[min:Tip:nk]' pivot='key' type='nominal' />
            <column-instance column='[fed]' derivation='Min' name='[min:fed:nk]' pivot='key' type='nominal' />
            <column caption='Nation' datatype='string' name='[nation]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Dot]' derivation='None' name='[none:Dot:nk]' pivot='key' type='nominal' />
            <column-instance column='[Show]' derivation='None' name='[none:Show:nk]' pivot='key' type='nominal' />
            <column-instance column='[era]' derivation='None' name='[none:era:nk]' pivot='key' type='nominal' />
            <column-instance column='[player]' derivation='None' name='[none:player:nk]' pivot='key' type='nominal' />
            <column caption='Player' datatype='string' name='[player]' role='dimension' type='nominal' />
            <column-instance column='[Dot size]' derivation='Sum' name='[sum:Dot size:qk]' pivot='key' type='quantitative' />
            <column-instance column='[x]' derivation='Sum' name='[sum:x:qk]' pivot='key' type='quantitative' />
            <column-instance column='[y]' derivation='Sum' name='[sum:y:qk]' pivot='key' type='quantitative' />
            <column caption='Title Age' datatype='real' name='[title_age]' role='measure' type='quantitative' />
            <column caption='Title Year' datatype='integer' name='[title_year]' role='measure' type='quantitative' />
            <column caption='X' datatype='real' default-format='n0;-0' name='[x]' role='measure' type='quantitative' />
            <column caption='Y' datatype='real' default-format='n0;-0' name='[y]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.gms].[none:Show:nk]'>
            <groupfilter function='member' level='[none:Show:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.gms].[none:Show:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.gms].[sum:y:qk]' field-type='quantitative' max='50.0' min='10.0' range-type='fixed' scope='rows' type='space' />
            <format attr='color' value='#6B6157' />
            <format attr='font-size' value='9' />
            <format attr='title' class='0' field='[federated.gms].[sum:x:qk]' scope='cols' value='' />
            <format attr='title' class='0' field='[federated.gms].[sum:y:qk]' scope='rows' value='' />
            <encoding attr='space' class='0' field='[federated.gms].[sum:x:qk]' field-type='quantitative' max='2025.5999999999999' min='2000.4000000000001' range-type='fixed' scope='cols' type='space' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#6B6157' />
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.gms].[none:Dot:nk]' type='palette'>
              <map to='#231f1a'>
                <bucket>&quot;Median age&quot;</bucket>
              </map>
              <map to='#2f6e4f'>
                <bucket>&quot;Selected nation&quot;</bucket>
              </map>
              <map to='#c08a2e'>
                <bucket>&quot;Young&quot;</bucket>
              </map>
              <map to='#d8ccb8'>
                <bucket>&quot;Grandmaster&quot;</bucket>
              </map>
              <map to='#d8ccb8'>
                <bucket>&quot;Other nations&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
          <style-rule element='pane'>
            <format attr='border-color' value='#FFFDF8' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#FFFDF8' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='color' value='#231F1A' />
            <format attr='display-field-labels' scope='cols' value='false' />
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
          <style-rule element='dropline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='on' />
            <format attr='stroke-color' value='#EFE8DC' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.gms].[none:Dot:nk]' />
              <size column='[federated.gms].[sum:Dot size:qk]' />
              <lod column='[federated.gms].[none:player:nk]' />
              <lod column='[federated.gms].[none:era:nk]' />
              <tooltip column='[federated.gms].[min:Tip:nk]' />
              <tooltip column='[federated.gms].[min:fed:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontcolor='#7a4a2a' fontname='Georgia' fontsize='12'><![CDATA[<[federated.gms].[none:player:nk]>]]></run>
                <run> (</run>
                <run fontcolor='#6b6157'>&lt;[federated.gms].[min:fed:nk]&gt;</run>
                <run>)</run>
                <run>Æ&#10;</run>
                <run>&lt;[federated.gms].[min:Tip:nk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='0.6' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.gms].[sum:y:qk]</rows>
        <cols>[federated.gms].[sum:x:qk]</cols>
      </table>
      <simple-id uuid='{94C60AD7-0911-420A-B83C-3883FA01E24A}' />
    </worksheet>
    <worksheet name='Record'>
