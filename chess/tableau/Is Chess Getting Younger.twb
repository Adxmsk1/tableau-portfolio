            <format attr='title' class='0' field='[federated.records].[sum:age:qk]' scope='rows' value='' />
            <encoding attr='space' class='0' field='[federated.records].[sum:x:qk]' field-type='quantitative' max='2026.0' min='1946.0' range-type='fixed' scope='cols' type='space' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#6B6157' />
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='mark'>
