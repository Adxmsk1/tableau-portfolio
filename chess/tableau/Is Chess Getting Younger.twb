                <run bold='true' fontcolor='#7a4a2a' fontname='Georgia' fontsize='12'><![CDATA[<[federated.records].[none:player:nk]>]]></run>
                <run> (</run>
                <run fontcolor='#6b6157'><![CDATA[<[federated.records].[min:country:nk]>]]></run>
                <run>)</run>
                <run>Æ&#10;</run>
                <run>Youngest grandmaster ever in </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.records].[sum:year:qk]>]]></run>
                <run>, aged </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.records].[min:age_label:nk]>]]></run>
                <run>Æ&#10;</run>
                <run>The record stood for </run>
                <run><![CDATA[<[federated.records].[sum:held_for:qk]>]]></run>
                <run> years</run>
